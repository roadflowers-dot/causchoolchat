rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 관리자 =====
    // 관리자 이메일 목록. 관리자를 추가/변경하려면 여기를 고친 뒤 다시 배포하세요.
    // (이 파일은 웹사이트에 공개되지 않고 Firebase 서버에만 올라갑니다)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['roadflowers@gmail.com'];
    }

    function myEmail() { return request.auth.token.email.lower(); }
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }

    // 메시지에 붙는 이름·사진 칸 크기 제한
    function validSender(d) {
      return (!('name' in d) || d.name == null || (d.name is string && d.name.size() <= 100))
        && (!('photo' in d) || d.photo == null || (d.photo is string && d.photo.size() <= 1000));
    }

    // 들어올 수 있는 사람: 관리자, 또는 '관리자가 초대한 Gmail'로 로그인했고 차단되지 않은 사용자
    // (초대 목록에 없는 외부 사람은 아무것도 읽거나 쓸 수 없음)
    function isMember() {
      return request.auth != null
        && (isAdmin() || (
          request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/invites/$(myEmail()))
          && !exists(/databases/$(database)/documents/banned/$(request.auth.uid))));
    }

    // 파일 크기 제한: 5MB (= 900KB 조각 최대 6개). firebase-config.js의 MAX_FILE_MB와 맞추세요.
    function maxFileBytes() { return 5 * 1024 * 1024; }
    function maxChunks() { return 6; }
    function chunkBytes() { return 900 * 1024; }

    // 관리자 확인용 (관리자만 읽을 수 있음 → 앱이 관리자 모드를 켤지 판단)
    match /admin/{doc} {
      allow read: if isAdmin();
    }

    // 초대 목록 (문서 이름 = 소문자 이메일). 관리자만 추가/삭제. 본인은 자기가 초대됐는지 확인 가능
    match /invites/{email} {
      allow get: if verified() && (myEmail() == email || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && email == email.lower()
        && email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$');
      allow delete: if isAdmin();
    }

    // 입장 요청: 등록(초대)되지 않은 사람이 로그인하면 자기 정보를 남김 → 관리자에게 알림
    // 본인 것만 쓸 수 있고, 관리자만 목록을 보고 지울 수 있음
    match /pending/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'photo', 'at'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.at == request.time
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && (request.resource.data.photo == null
            || (request.resource.data.photo is string && request.resource.data.photo.size() <= 1000));
      allow delete: if isAdmin();
    }

    // 차단 목록: 관리자만 추가/해제. 본인은 자기가 차단됐는지 확인 가능
    match /banned/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, delete: if isAdmin() && uid != request.auth.uid;
    }

    // 이메일 주소: 다른 학생들에게 보이지 않도록 따로 보관 (본인과 관리자만 볼 수 있음)
    match /emails/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email == request.auth.token.email;
      // 관리자: 예전 데이터 정리할 때 프로필의 이메일을 이곳으로 옮겨 담기
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 320;
    }

    // 사용자 프로필 (닉네임·프로필 사진) — 이메일은 넣지 않음
    match /users/{uid} {
      function validProfile(d) {
        return d.keys().hasOnly(['name', 'photo', 'lastSeen', 'nickname', 'avatar', 'admin'])
          && validSender(d)
          && d.get('admin', false) == isAdmin()
          && (!('nickname' in d) || (d.nickname is string && d.nickname.size() >= 1 && d.nickname.size() <= 20))
          && (!('avatar' in d) || (d.avatar is string && d.avatar.size() <= 60000
              && (d.avatar == '' || d.avatar.matches('^(emoji:.{1,16}|data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+)$'))));
      }
      allow read: if isMember();
      allow create, update: if isMember() && request.auth.uid == uid && validProfile(request.resource.data);
      // 관리자: 예전 버전에서 저장된 이메일 칸을 지우는 것만 가능
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email'])
        && !('email' in request.resource.data);
    }

    match /rooms/{roomId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt']);
      // 메시지를 보낼 때 '마지막 메시지'(목록 미리보기·알림용)만 갱신 가능. 관리자는 이름·공지 변경 가능
      allow update: if isAdmin() || (isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'lastMessage'])
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastMessage.keys().hasOnly(['uid', 'name', 'text'])
        && request.resource.data.lastMessage.uid == request.auth.uid
        && request.resource.data.lastMessage.text is string
        && request.resource.data.lastMessage.text.size() <= 100);
      allow delete: if isAdmin();

      function fileDoc(fileId) {
        return /databases/$(database)/documents/rooms/$(roomId)/files/$(fileId);
      }

      match /messages/{msgId} {
        function validReply(d) {
          return !('replyTo' in d)
            || (d.replyTo.keys().hasOnly(['id', 'name', 'text'])
                && d.replyTo.text is string && d.replyTo.text.size() <= 120);
        }
        allow read: if isMember();
        // 본인 이름으로만 작성 (반응은 처음부터 넣을 수 없음)
        allow create: if isMember()
          && request.resource.data.uid == request.auth.uid
          && !('reactions' in request.resource.data)
          && validReply(request.resource.data)
          && validSender(request.resource.data)
          && (
            (request.resource.data.type == 'text'
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000)
            ||
            (request.resource.data.type == 'file'
              && getAfter(fileDoc(request.resource.data.file.id)).data.uid == request.auth.uid)
          );
        // 반응: 누구나 '자기 반응 하나'만 추가/변경/취소 가능. 메시지 내용은 수정 불가
        allow update: if isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.reactions)
              || request.resource.data.reactions[request.auth.uid] in ['👍', '❤️', '😂', '😮', '😢', '🎉']);
        // 삭제: 본인 메시지 또는 관리자
        allow delete: if isMember() && (resource.data.uid == request.auth.uid || isAdmin());
      }

      // 파일 정보 (Cloud Storage 대신 Firestore에 저장 — 무료 요금제용)
      // 조각(chunks)을 먼저 올린 뒤 만들 수 있음. 첫 조각과 마지막 조각이 본인 것인지 확인.
      match /files/{fileId} {
        function chunk(i) {
          return /databases/$(database)/documents/rooms/$(roomId)/files/$(fileId)/chunks/$(string(i));
        }
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 200
          && request.resource.data.size is int
          && request.resource.data.size <= maxFileBytes()
          && request.resource.data.chunkCount is int
          && request.resource.data.chunkCount >= 1
          && request.resource.data.chunkCount <= maxChunks()
          && get(chunk(0)).data.uid == request.auth.uid
          && get(chunk(request.resource.data.chunkCount - 1)).data.uid == request.auth.uid;
        allow delete: if isMember() && (resource.data.uid == request.auth.uid || isAdmin());

        // 파일 내용 조각 (0, 1, 2, ...) — 새로 만들기만 가능, 덮어쓰기 불가
        match /chunks/{chunkId} {
          allow read: if isMember();
          allow create: if isMember()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.i == int(chunkId)
            && request.resource.data.i < maxChunks()
            && request.resource.data.data is bytes
            && request.resource.data.data.size() <= chunkBytes();
          allow delete: if isMember() && (resource.data.uid == request.auth.uid || isAdmin());
        }
      }
    }
    // ===== 1:1 채팅 =====
    // 문서 이름: dm_{작은uid}_{큰uid}  → 이름만 봐도 두 사람이 누군지 알 수 있음
    // 두 사람만 읽고 쓸 수 있음 (관리자도 볼 수 없음)
    match /dms/{dmId} {
      function dmParts() { return dmId.split('_'); }
      function inDm() {
        return isMember() && dmParts().size() == 3 && dmParts()[0] == 'dm'
          && (request.auth.uid == dmParts()[1] || request.auth.uid == dmParts()[2]);
      }
      allow get: if inDm();
      allow list: if isMember() && request.auth.uid in resource.data.members;
      allow create: if inDm()
        && dmParts()[1] < dmParts()[2]
        && request.resource.data.members == [dmParts()[1], dmParts()[2]]
        && exists(/databases/$(database)/documents/users/$(dmParts()[1]))
        && exists(/databases/$(database)/documents/users/$(dmParts()[2]))
        && request.resource.data.keys().hasOnly(['members', 'createdAt']);
      allow update: if inDm()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'lastMessage'])
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastMessage.keys().hasOnly(['uid', 'name', 'text'])
        && request.resource.data.lastMessage.uid == request.auth.uid
        && request.resource.data.lastMessage.text is string
        && request.resource.data.lastMessage.text.size() <= 100;

      function dmFileDoc(fileId) {
        return /databases/$(database)/documents/dms/$(dmId)/files/$(fileId);
      }

      match /messages/{msgId} {
        function validReply(d) {
          return !('replyTo' in d)
            || (d.replyTo.keys().hasOnly(['id', 'name', 'text'])
                && d.replyTo.text is string && d.replyTo.text.size() <= 120);
        }
        allow read: if inDm();
        allow create: if inDm()
          && request.resource.data.uid == request.auth.uid
          && !('reactions' in request.resource.data)
          && validReply(request.resource.data)
          && validSender(request.resource.data)
          && (
            (request.resource.data.type == 'text'
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000)
            ||
            (request.resource.data.type == 'file'
              && getAfter(dmFileDoc(request.resource.data.file.id)).data.uid == request.auth.uid)
          );
        allow update: if inDm()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.reactions)
              || request.resource.data.reactions[request.auth.uid] in ['👍', '❤️', '😂', '😮', '😢', '🎉']);
        allow delete: if inDm() && resource.data.uid == request.auth.uid;
      }

      match /files/{fileId} {
        function dmChunk(i) {
          return /databases/$(database)/documents/dms/$(dmId)/files/$(fileId)/chunks/$(string(i));
        }
        allow read: if inDm();
        allow create: if inDm()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 200
          && request.resource.data.size is int
          && request.resource.data.size <= maxFileBytes()
          && request.resource.data.chunkCount is int
          && request.resource.data.chunkCount >= 1
          && request.resource.data.chunkCount <= maxChunks()
          && get(dmChunk(0)).data.uid == request.auth.uid
          && get(dmChunk(request.resource.data.chunkCount - 1)).data.uid == request.auth.uid;
        allow delete: if inDm() && resource.data.uid == request.auth.uid;

        match /chunks/{chunkId} {
          allow read: if inDm();
          allow create: if inDm()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.i == int(chunkId)
            && request.resource.data.i < maxChunks()
            && request.resource.data.data is bytes
            && request.resource.data.data.size() <= chunkBytes();
          allow delete: if inDm() && resource.data.uid == request.auth.uid;
        }
      }
    }
  }
}
