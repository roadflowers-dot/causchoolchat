rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===================== 사람 구분 =====================

    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }

    // 최고 관리자 (이 파일에만 있고 웹사이트에는 공개되지 않음). 부관리자를 추가/삭제할 수 있는 유일한 사람
    function isOwner() {
      return verified() && request.auth.token.email in ['roadflowers@gmail.com'];
    }
    // 관리자 = 최고 관리자 + 최고 관리자가 이메일로 추가한 부관리자(admins 목록)
    function isAdmin() {
      return isOwner() || (verified() && exists(/databases/$(database)/documents/admins/$(myEmail())));
    }
    // 들어올 수 있는 사람: 관리자, 또는 초대된 Gmail로 로그인했고 차단되지 않은 사용자
    function isMember() {
      return isAdmin() || (verified()
        && exists(/databases/$(database)/documents/invites/$(myEmail()))
        && !exists(/databases/$(database)/documents/banned/$(request.auth.uid)));
    }

    // ===================== 공통 검사 =====================

    // 파일 크기 제한: 5MB (= 900KB 조각 최대 6개). firebase-config.js의 MAX_FILE_MB와 맞추세요.
    function maxFileBytes() { return 5 * 1024 * 1024; }
    function maxChunks() { return 6; }
    function chunkBytes() { return 900 * 1024; }
    function reactionEmojis() { return ['👍', '❤️', '😂', '😮', '😢', '🎉']; }

    // 메시지에 붙는 이름·사진 칸 크기 제한
    function validSender(d) {
      return (!('name' in d) || d.name == null || (d.name is string && d.name.size() <= 100))
        && (!('photo' in d) || d.photo == null || (d.photo is string && d.photo.size() <= 1000));
    }
    function validText(t) { return t is string && t.size() > 0 && t.size() <= 2000; }
    function validReply(d) {
      return !('replyTo' in d)
        || (d.replyTo.keys().hasOnly(['id', 'name', 'text'])
            && d.replyTo.text is string && d.replyTo.text.size() <= 120);
    }
    // 투표: 질문 1~200자, 선택지 2~6개 (각 1~50자)
    function optOk(o, i) { return i >= o.size() || (o[i] is string && o[i].size() >= 1 && o[i].size() <= 50); }
    function validPoll(p) {
      return p.keys().hasOnly(['question', 'options'])
        && p.question is string && p.question.size() >= 1 && p.question.size() <= 200
        && p.options is list && p.options.size() >= 2 && p.options.size() <= 6
        && optOk(p.options, 0) && optOk(p.options, 1) && optOk(p.options, 2)
        && optOk(p.options, 3) && optOk(p.options, 4) && optOk(p.options, 5);
    }

    // 새 메시지 (fileDocPath: 첨부 파일 정보 문서 경로)
    function validNewMessage(fileDocPath) {
      let d = request.resource.data;
      return d.uid == request.auth.uid
        && !('reactions' in d) && !('votes' in d) && !('closed' in d) && !('editedAt' in d)
        && validReply(d) && validSender(d)
        && (
          (d.type == 'text' && validText(d.text))
          || (d.type == 'file' && getAfter(fileDocPath).data.uid == request.auth.uid)
          || (d.type == 'poll' && validPoll(d.poll))
        );
    }

    // 메시지 바꾸기: ① 반응 ② 내 글 수정 ③ 투표하기 ④ 내 투표 마감
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function validMessageUpdate() {
      let d = request.resource.data;
      let uid = request.auth.uid;
      return (
        // ① 반응: 자기 반응 하나만 추가/변경/취소
        changed().hasOnly(['reactions'])
        && d.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([uid])
        && (!(uid in d.reactions) || d.reactions[uid] in reactionEmojis())
      ) || (
        // ② 수정: 내 글자 메시지만, 내용과 수정 시각만
        resource.data.uid == uid && resource.data.type == 'text'
        && changed().hasOnly(['text', 'editedAt'])
        && validText(d.text) && d.editedAt == request.time
      ) || (
        // ③ 투표: 마감 안 된 투표에 자기 표 하나만
        resource.data.type == 'poll' && resource.data.get('closed', false) != true
        && changed().hasOnly(['votes'])
        && d.votes.diff(resource.data.get('votes', {})).affectedKeys().hasOnly([uid])
        && (!(uid in d.votes) || (d.votes[uid] is int && d.votes[uid] >= 0 && d.votes[uid] < resource.data.poll.options.size()))
      ) || (
        // ④ 마감: 투표를 만든 사람(또는 관리자)
        resource.data.type == 'poll' && (resource.data.uid == uid || isAdmin())
        && changed().hasOnly(['closed']) && d.closed == true
      );
    }

    // 채팅방 '마지막 메시지'(목록 미리보기·알림용) 갱신
    function validLastMessageUpdate() {
      let d = request.resource.data;
      return changed().hasOnly(['lastMessageAt', 'lastMessage'])
        && d.lastMessageAt == request.time
        && d.lastMessage.keys().hasOnly(['uid', 'name', 'text'])
        && d.lastMessage.uid == request.auth.uid
        && d.lastMessage.text is string && d.lastMessage.text.size() <= 100;
    }

    function validFileMeta() {
      let d = request.resource.data;
      return d.uid == request.auth.uid
        && d.name is string && d.name.size() <= 200
        && d.size is int && d.size <= maxFileBytes()
        && d.chunkCount is int && d.chunkCount >= 1 && d.chunkCount <= maxChunks();
    }
    function validChunk(chunkId) {
      let d = request.resource.data;
      return d.uid == request.auth.uid
        && d.i == int(chunkId) && d.i < maxChunks()
        && d.data is bytes && d.data.size() <= chunkBytes();
    }
    // "입력 중…" 표시: 자기 것만, 시각만
    function validTyping(uid) {
      return uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
    }

    // ===================== 관리 =====================

    // 관리자 확인용: 'owner'는 최고 관리자만, 나머지는 관리자만 읽을 수 있음
    match /admin/{doc} {
      allow read: if (doc == 'owner' && isOwner()) || (doc != 'owner' && isAdmin());
    }

    // 부관리자 목록 (문서 이름 = 소문자 이메일). 최고 관리자만 추가/삭제
    match /admins/{email} {
      allow get: if verified() && (myEmail() == email || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner() && email == email.lower()
        && email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.keys().hasOnly(['by', 'at']);
      allow delete: if isOwner();
    }

    // 금지어 목록 (나쁜 말 필터): 모두 읽기, 관리자만 수정
    match /config/{doc} {
      allow read: if isMember();
      allow write: if isAdmin() && doc == 'filter'
        && request.resource.data.keys().hasOnly(['words', 'updatedAt'])
        && request.resource.data.words is list && request.resource.data.words.size() <= 500;
    }

    // 초대 목록 (문서 이름 = 소문자 이메일). 관리자만 추가/삭제. 본인은 자기가 초대됐는지 확인 가능
    match /invites/{email} {
      allow get: if verified() && (myEmail() == email || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && email == email.lower()
        && email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$');
      allow delete: if isAdmin();
    }

    // 입장 요청: 등록(초대)되지 않은 사람이 로그인하면 자기 정보를 남김 → 관리자에게 알림
    match /pending/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'photo', 'at'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.at == request.time
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && (request.resource.data.photo == null
            || (request.resource.data.photo is string && request.resource.data.photo.size() <= 1000));
      allow delete: if isAdmin();
    }

    // 차단 목록: 관리자만 추가/해제. 본인은 자기가 차단됐는지 확인 가능
    match /banned/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, delete: if isAdmin() && uid != request.auth.uid;
    }

    // 이메일 주소: 다른 학생들에게 보이지 않도록 따로 보관 (본인과 관리자만 볼 수 있음)
    match /emails/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email == request.auth.token.email;
      // 관리자: 예전 데이터 정리할 때 프로필의 이메일을 이곳으로 옮겨 담기
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 320;
    }

    // 사용자 프로필 (닉네임·프로필 사진) — 이메일은 넣지 않음
    match /users/{uid} {
      function validProfile(d) {
        return d.keys().hasOnly(['name', 'photo', 'lastSeen', 'nickname', 'avatar', 'admin'])
          && validSender(d)
          && d.get('admin', false) == isAdmin()
          && (!('nickname' in d) || (d.nickname is string && d.nickname.size() >= 1 && d.nickname.size() <= 20))
          && (!('avatar' in d) || (d.avatar is string && d.avatar.size() <= 60000
              && (d.avatar == '' || d.avatar.matches('^(emoji:.{1,16}|data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+)$'))));
      }
      allow read: if isMember();
      allow create, update: if isMember() && request.auth.uid == uid && validProfile(request.resource.data);
      // 관리자: 예전 버전에서 저장된 이메일 칸을 지우는 것만 가능
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email'])
        && !('email' in request.resource.data);
    }

    // 파일 목록 (저장 공간 관리용): 크기·날짜만 있고 파일 이름·내용은 없음. 관리자만 열람
    match /fileIndex/{fileId} {
      allow get, list: if isAdmin();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['kind', 'roomId', 'size', 'chunkCount', 'uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['rooms', 'dms']
        && request.resource.data.at == request.time
        && request.resource.data.size is int && request.resource.data.size <= maxFileBytes()
        && request.resource.data.chunkCount is int && request.resource.data.chunkCount >= 1
        && request.resource.data.chunkCount <= maxChunks()
        && getAfter(/databases/$(database)/documents/$(request.resource.data.kind)/$(request.resource.data.roomId)/files/$(fileId)).data.uid == request.auth.uid;
      allow delete: if isAdmin() || (request.auth != null && (resource == null || resource.data.uid == request.auth.uid));
    }

    // ===================== 단체 채팅방 =====================
    // visibility: 'public'(등록된 모두) / 'private'(members에 있는 사람만). 관리자는 모든 방을 볼 수 있음
    function canSeeRoom(r) {
      return isAdmin() || (isMember()
        && (r.get('visibility', 'public') == 'public' || request.auth.uid in r.get('members', [])));
    }

    match /rooms/{roomId} {
      function room() { return get(/databases/$(database)/documents/rooms/$(roomId)).data; }
      function canSee() { return canSeeRoom(room()); }
      function fileDoc(fileId) { return /databases/$(database)/documents/rooms/$(roomId)/files/$(fileId); }

      allow get: if canSeeRoom(resource.data);
      allow list: if isAdmin() || (isMember()
        && (resource.data.get('visibility', 'public') == 'public' || request.auth.uid in resource.data.get('members', [])));
      // 채팅방은 관리자만 만들 수 있음
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt', 'visibility', 'members'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.visibility in ['public', 'private']
        && (!('members' in request.resource.data)
            || (request.resource.data.members is list && request.resource.data.members.size() <= 500));
      // 관리자: 이름·공지·멤버 등 변경 / 멤버: 메시지 보낼 때 '마지막 메시지'만
      allow update: if isAdmin() || (canSeeRoom(resource.data) && validLastMessageUpdate());
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if canSee();
        allow create: if canSee() && validNewMessage(fileDoc(request.resource.data.get('file', {'id': 'none'}).get('id', 'none')));
        allow update: if canSee() && validMessageUpdate();
        allow delete: if canSee() && (resource.data.uid == request.auth.uid || isAdmin());
      }

      match /typing/{uid} {
        allow read: if canSee();
        allow create, update: if canSee() && validTyping(uid);
        allow delete: if request.auth != null && uid == request.auth.uid;
      }

      // 파일 정보 (Cloud Storage 대신 Firestore에 저장 — 무료 요금제용)
      // 조각(chunks)을 먼저 올린 뒤 만들 수 있음. 첫 조각과 마지막 조각이 본인 것인지 확인.
      match /files/{fileId} {
        function chunk(i) { return /databases/$(database)/documents/rooms/$(roomId)/files/$(fileId)/chunks/$(string(i)); }
        allow read: if canSee();
        allow create: if canSee() && validFileMeta()
          && get(chunk(0)).data.uid == request.auth.uid
          && get(chunk(request.resource.data.chunkCount - 1)).data.uid == request.auth.uid;
        allow delete: if isAdmin() || (canSee() && resource.data.uid == request.auth.uid);

        // 파일 내용 조각 (0, 1, 2, ...) — 새로 만들기만 가능, 덮어쓰기 불가
        match /chunks/{chunkId} {
          allow read: if canSee();
          allow create: if canSee() && validChunk(chunkId);
          allow delete: if isAdmin() || (canSee() && resource.data.uid == request.auth.uid);
        }
      }
    }

    // ===================== 1:1 채팅 =====================
    // 문서 이름: dm_{작은uid}_{큰uid}. 두 사람만 읽고 쓸 수 있음 (관리자도 내용을 볼 수 없음)
    match /dms/{dmId} {
      function dmParts() { return dmId.split('_'); }
      function inDm() {
        return isMember() && dmParts().size() == 3 && dmParts()[0] == 'dm'
          && (request.auth.uid == dmParts()[1] || request.auth.uid == dmParts()[2]);
      }
      function dmFileDoc(fileId) { return /databases/$(database)/documents/dms/$(dmId)/files/$(fileId); }

      allow get: if inDm();
      allow list: if isMember() && request.auth.uid in resource.data.members;
      allow create: if inDm()
        && dmParts()[1] < dmParts()[2]
        && request.resource.data.members == [dmParts()[1], dmParts()[2]]
        && exists(/databases/$(database)/documents/users/$(dmParts()[1]))
        && exists(/databases/$(database)/documents/users/$(dmParts()[2]))
        && request.resource.data.keys().hasOnly(['members', 'createdAt']);
      allow update: if inDm() && validLastMessageUpdate();

      match /messages/{msgId} {
        allow read: if inDm();
        allow create: if inDm() && validNewMessage(dmFileDoc(request.resource.data.get('file', {'id': 'none'}).get('id', 'none')));
        allow update: if inDm() && validMessageUpdate();
        allow delete: if inDm() && resource.data.uid == request.auth.uid;
      }

      match /typing/{uid} {
        allow read: if inDm();
        allow create, update: if inDm() && validTyping(uid);
        allow delete: if request.auth != null && uid == request.auth.uid;
      }

      // 관리자는 저장 공간 정리 때 오래된 파일을 지울 수만 있음 (읽을 수는 없음)
      match /files/{fileId} {
        function dmChunk(i) { return /databases/$(database)/documents/dms/$(dmId)/files/$(fileId)/chunks/$(string(i)); }
        allow read: if inDm();
        allow create: if inDm() && validFileMeta()
          && get(dmChunk(0)).data.uid == request.auth.uid
          && get(dmChunk(request.resource.data.chunkCount - 1)).data.uid == request.auth.uid;
        allow delete: if isAdmin() || (inDm() && resource.data.uid == request.auth.uid);

        match /chunks/{chunkId} {
          allow read: if inDm();
          allow create: if inDm() && validChunk(chunkId);
          allow delete: if isAdmin() || (inDm() && resource.data.uid == request.auth.uid);
        }
      }
    }
  }
}
